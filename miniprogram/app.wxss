page {
  min-height: 100%;
  --bg: #FFF8F3;
  --card: #FFFFFF;
  --brand: #FF6B35;
  --brand-soft: #FFEDE3;
  --brand-deep: #E0512B;
  --ink: #2B2118;
  --ink-2: #6F6357;
  --ink-3: #A79A8C;
  --line: #F2E7DC;
  --safe: #1D9E6E;
  --safe-soft: #E4F6EE;
  --warn: #D9482B;
  --warn-soft: #FDEBE6;
  --gold: #F0A02B;
  --gold-soft: #FDF3E0;
  --blue: #3D7BD9;
  --blue-soft: #E8F0FB;

  background: var(--bg);
  color: var(--ink);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

button {
  border-radius: 20rpx;
}

view,
text {
  box-sizing: border-box;
}

/* ---------- 通用布局 ---------- */
.page-pad {
  padding: 24rpx 28rpx 48rpx;
}

.card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(90, 60, 30, 0.05);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  margin: 32rpx 4rpx 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title .hint {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--ink-3);
}

/* ---------- 按钮 ---------- */
.btn {
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
  line-height: 1.2;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: var(--brand);
  color: #fff;
}

.btn-primary.disabled {
  opacity: 0.45;
}

.btn-ghost {
  background: var(--brand-soft);
  color: var(--brand-deep);
}

.btn-plain {
  background: var(--card);
  color: var(--ink-2);
  border: 2rpx solid var(--line);
}

.btn-mini {
  display: inline-flex;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 500;
}

/* ---------- 标签 ---------- */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: var(--brand-soft);
  color: var(--brand-deep);
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}

.tag-line {
  background: transparent;
  border: 2rpx solid var(--line);
  color: var(--ink-2);
}

.tag-selected {
  background: var(--brand);
  color: #fff;
  border-color: var(--brand);
}

.tag-danger {
  background: var(--warn-soft);
  color: var(--warn);
}

.tag-safe {
  background: var(--safe-soft);
  color: var(--safe);
}

/* ---------- 表单 ---------- */
.field {
  margin-bottom: 30rpx;
}

.field-label {
  font-size: 26rpx;
  color: var(--ink-2);
  margin-bottom: 14rpx;
  display: flex;
  align-items: center;
}

.field-label .req {
  color: var(--warn);
  margin-left: 6rpx;
}

.field-input {
  background: var(--bg);
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: var(--ink);
}

.field-textarea {
  background: var(--bg);
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  width: 100%;
  min-height: 140rpx;
}

/* ---------- 空态 ---------- */
.empty {
  text-align: center;
  padding: 90rpx 40rpx;
  color: var(--ink-3);
  font-size: 26rpx;
}

.empty .emoji {
  font-size: 72rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty .main {
  color: var(--ink-2);
  font-size: 28rpx;
  margin-bottom: 10rpx;
}

/* ---------- 分隔 ---------- */
.divider {
  height: 2rpx;
  background: var(--line);
  margin: 24rpx 0;
}

/* ---------- 通用行 ---------- */
.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.grow {
  flex: 1;
  min-width: 0;
}
