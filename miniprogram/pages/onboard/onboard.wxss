.steps {
  display: flex;
  justify-content: center;
  gap: 14rpx;
  padding: 16rpx 0 8rpx;
}

.step-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--line);
}

.step-dot.on {
  background: var(--brand);
}

.hero {
  padding: 24rpx 4rpx 12rpx;
  display: flex;
  flex-direction: column;
}

.hero-slogan {
  color: var(--brand);
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.hero-title {
  margin-top: 10rpx;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.4;
}

.hero-title-sm {
  font-size: 38rpx;
  font-weight: 700;
}

.card {
  margin-top: 20rpx;
}

.para {
  display: block;
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--ink-2);
}

.para.muted {
  color: var(--ink-3);
  font-size: 24rpx;
}

.block-title {
  display: block;
  margin-bottom: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.data-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.data-emoji {
  font-size: 38rpx;
  margin-right: 20rpx;
}

.data-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
}

.data-desc {
  display: block;
  margin-top: 6rpx;
  color: var(--ink-3);
  font-size: 24rpx;
  line-height: 1.6;
}

.cta {
  margin-top: 36rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
}

.chips .tag {
  margin-bottom: 12rpx;
}

.req {
  color: var(--warn);
  font-size: 24rpx;
  font-weight: 400;
}

.hint {
  color: var(--ink-3);
  font-size: 24rpx;
  font-weight: 400;
}

.safe-card {
  border: 2rpx solid #f6cabb;
}

.custom-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
}

.custom-input {
  flex: 1;
  background: var(--bg);
  border-radius: 16rpx;
  padding: 16rpx 22rpx;
  font-size: 26rpx;
}

.warn-box {
  margin-top: 24rpx;
  background: var(--warn-soft);
  border-radius: 20rpx;
  padding: 24rpx;
}

.warn-text {
  display: block;
  color: var(--warn);
  font-size: 26rpx;
  line-height: 1.7;
}

.warn-skip {
  display: block;
  margin-top: 14rpx;
  color: var(--ink-3);
  font-size: 24rpx;
  text-decoration: underline;
}

.num-row {
  display: flex;
  align-items: center;
  background: var(--bg);
  border-radius: 18rpx;
  padding: 18rpx 24rpx;
}

.num-prefix {
  color: var(--brand);
  font-size: 34rpx;
  font-weight: 600;
  margin-right: 12rpx;
}

.num-input {
  flex: 1;
  font-size: 34rpx;
  font-weight: 600;
}

.btn-row {
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
}

.btn-half {
  flex: 1;
}

.kv-row {
  display: flex;
  margin-top: 16rpx;
  font-size: 26rpx;
}

.kv-key {
  width: 170rpx;
  color: var(--ink-3);
  flex-shrink: 0;
}

.kv-val {
  color: var(--ink);
  flex: 1;
}

.tip-card {
  background: var(--brand-soft);
}

.tip-card .para {
  color: var(--brand-deep);
}
