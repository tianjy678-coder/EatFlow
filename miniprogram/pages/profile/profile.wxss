.head {
  display: flex;
  align-items: center;
  padding: 24rpx 8rpx 8rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  background: var(--brand);
  color: #fff;
  font-size: 44rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.app-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
}

.slogan {
  display: block;
  margin-top: 6rpx;
  color: var(--ink-3);
  font-size: 24rpx;
}

.card {
  margin-top: 0;
}

.link {
  color: var(--brand);
  font-size: 24rpx;
  font-weight: 400;
}

.kv-row {
  display: flex;
  margin-top: 14rpx;
  font-size: 26rpx;
}

.kv-key {
  width: 130rpx;
  color: var(--ink-3);
  flex-shrink: 0;
}

.kv-val {
  color: var(--ink);
  flex: 1;
}

.chip-row {
  margin-top: 20rpx;
}

.muted {
  display: block;
  margin-top: 16rpx;
  color: var(--ink-3);
  font-size: 24rpx;
  line-height: 1.6;
}

.card-btn {
  margin-top: 20rpx;
}

.menu {
  padding: 8rpx 28rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-emoji {
  font-size: 34rpx;
  margin-right: 22rpx;
}

.menu-text {
  font-size: 28rpx;
}

.menu-sub {
  display: block;
  margin-top: 4rpx;
  color: var(--ink-3);
  font-size: 22rpx;
}

.menu-badge {
  background: var(--gold-soft);
  color: var(--gold);
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  margin-right: 12rpx;
}

.menu-arrow {
  color: var(--ink-3);
  font-size: 34rpx;
}

.warn-text {
  color: var(--warn);
}

.about {
  padding-bottom: 10rpx;
}

.about-line {
  display: block;
  font-size: 24rpx;
  color: var(--ink-3);
  line-height: 1.9;
}

.data-note {
  margin-top: 20rpx;
}

.data-note .about-line {
  color: var(--ink-2);
}

  display: block;
  margin-top: 14rpx;
  color: var(--ink-3);
  font-size: 22rpx;
}
