.page-tip {
  display: block;
  padding: 8rpx 4rpx 0;
  color: var(--ink-3);
  font-size: 24rpx;
}

.card {
  margin-top: 0;
}

.req {
  color: var(--warn);
  font-size: 24rpx;
  font-weight: 400;
}

.chips {
  display: flex;
  flex-wrap: wrap;
}

.chips .tag {
  margin-bottom: 12rpx;
}

.custom-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
}

.custom-input {
  flex: 1;
  background: var(--bg);
  border-radius: 16rpx;
  padding: 16rpx 22rpx;
  font-size: 26rpx;
}

.num-row {
  display: flex;
  align-items: center;
  background: var(--bg);
  border-radius: 18rpx;
  padding: 18rpx 24rpx;
}

.num-prefix {
  color: var(--brand);
  font-size: 34rpx;
  font-weight: 600;
  margin-right: 12rpx;
}

.num-input {
  flex: 1;
  font-size: 34rpx;
  font-weight: 600;
}

.btn-wrap {
  margin-top: 44rpx;
}

.btn-wrap .btn {
  margin-bottom: 20rpx;
}

.danger {
  color: var(--warn);
  border-color: #f6cabb;
}
