<view class="page-pad">
  <!-- 当前位置 -->
  <view class="card">
    <view class="row-between">
      <view class="grow">
        <view class="loc-title">{{currentLabel}}</view>
        <view class="loc-desc">{{currentDesc}}</view>
      </view>
      <view wx:if="{{current}}" class="loc-dot"></view>
    </view>
    <view wx:if="{{areaHit}}" class="loc-badge">
      <text class="tag tag-safe">{{areaHit}}</text>
    </view>
    <view wx:else class="loc-badge">
      <text class="tag tag-line">该位置无内置数据，需联网搜索</text>
    </view>
  </view>

  <!-- 预设锚点 -->
  <view class="section-title">
    <text>校内常用位置</text>
    <text class="hint">已烘焙真实步行时间</text>
  </view>
  <view class="card">
    <view
      wx:for="{{presets}}"
      wx:key="id"
      class="loc-item {{item.selected ? 'on' : ''}}"
      data-id="{{item.id}}"
      bindtap="pickPreset"
    >
      <view class="grow">
        <view class="loc-name">{{item.label}}</view>
        <view class="loc-sub">{{item.tag}}</view>
      </view>
      <view class="loc-right">
        <text wx:if="{{item.distanceText}}" class="loc-dist">{{item.distanceText}}</text>
        <text wx:if="{{item.selected}}" class="loc-check">✓</text>
      </view>
    </view>
  </view>

  <!-- 自选位置 -->
  <view class="section-title">
    <text>其它位置</text>
    <text class="hint">在地图上点选</text>
  </view>
  <view class="card">
    <view class="loc-item" bindtap="openMap">
      <view class="grow">
        <view class="loc-name">在地图上选一个位置</view>
        <view class="loc-sub">选你现在在的地方，或一会儿要去的地方</view>
      </view>
      <text class="loc-arrow">›</text>
    </view>
    <view
      wx:for="{{recent}}"
      wx:key="lat"
      class="loc-item {{item.selected ? 'on' : ''}}"
      data-idx="{{index}}"
      bindtap="pickRecent"
    >
      <view class="grow">
        <view class="loc-name">{{item.label}}</view>
        <view class="loc-sub">{{item.address}}</view>
      </view>
      <text wx:if="{{item.selected}}" class="loc-check">✓</text>
    </view>
  </view>

  <view class="card" wx:if="{{isCustom}}">
    <view class="loc-item no-border">
      <view class="grow">
        <text class="loc-name">我现在在宿舍</text>
        <text class="loc-sub">打开后才会推荐「自炊」这类需要回宿舍的选项</text>
      </view>
      <switch checked="{{atDorm}}" color="#FF6B35" bindchange="onDormToggle" />
    </view>
  </view>

  <view class="note">
    <text>位置只保存在本机，不会上传。周边店铺来自腾讯位置服务，价格与出餐时长按品类估算，页面会如实标注。</text>
  </view>

  <button class="btn btn-primary btn-fixed" bindtap="confirm">用这个位置</button>
</view>
